# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Login page: show the magic-link button and the "Forgot password?" link.
# Leave unset (or anything other than "true") while the project has no custom
# SMTP: both controls would fail, and learners see
# "Forgot your password? Message your teacher." instead.
# Read on the server at request time; set it in Vercel and redeploy.
NEXT_PUBLIC_EMAIL_LINKS_ENABLED=
