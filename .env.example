# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Login page: show the magic-link button and the "Forgot password?" link.
# Leave unset (or anything other than "true") while the project has no custom
# SMTP: both controls would fail, and learners see
# "Forgot your password? Message your teacher." instead.
# Read on the server at request time; set it in Vercel and redeploy.
NEXT_PUBLIC_EMAIL_LINKS_ENABLED=

# Login page: allow visitors to create their own account.
# Off unless exactly "true". Supabase must also allow signups (Auth → Providers
# → Email → "Allow new users to sign up"); with either one off, the sign-up tab
# says "Sign-up is closed during the pilot. Ask your teacher for an account."
NEXT_PUBLIC_SIGNUPS_ENABLED=

# Improved-answer TTS (/api/speaking/improved-tts):
# Off by default (leave unset or "false") so ElevenLabs is never called in
# production without a commercial plan; learners hear the browser's en-GB
# "Computer voice". Set to "true" only when a commercial ElevenLabs plan is active.
IMPROVED_ANSWER_TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=sp7QaEHmiNEd5HgrXuOo
ELEVENLABS_MONTHLY_CHAR_LIMIT=40000

