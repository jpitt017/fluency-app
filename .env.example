# ---------------------------------------------------------------------------
# App (Next.js) — English B1 → B2 course on the Supabase project
# Copy to `.env.local` for local development, and set the same values in Vercel
# (Preview + Production). NEXT_PUBLIC_* values are inlined at build time, so a
# change only takes effect after a redeploy.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://ebzmkhrssgnzmixfsuso.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Server only — Stripe webhook writes. Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# AI examiner (Whisper transcription + rubric scoring)
GROQ_API_KEY=""

# Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Direct Postgres connection for migrations (see supabase-b1-b2/.env.example)
DATABASE_URL=""
